# Copy this file to `.env.local` and set real values (never commit `.env.local`).
# Restart `npm run dev` after changes.

# Verbose `[yoochog:…]` console.log traces (also: localStorage `yoochog:debug:rtc` = "1", then reload).
# VITE_DEBUG_RTC=true

# Production/preview: public path prefix for the built app (Vite `base` / `import.meta.env.BASE_URL`).
# Omit or leave unset for the default GitHub Pages project site layout (`/yoochog/`).
# For a dedicated server with the app at the site root, use `/` (see docs/server-deployment.md).
# VITE_BASE_PATH=/

# Public HTTPS origin of this static deployment (scheme + host, no path). Required for production
# `npm run build`; used for absolute URLs in robots.txt / sitemap.xml. Examples:
#   GitHub Pages: https://neumerance.github.io
#   Dedicated host (root deploy): https://yoochoog.app
# VITE_PUBLIC_SITE_ORIGIN=https://neumerance.github.io

# Socket.io server base URL (scheme + host + port). Required for host/guest jukebox / karaoke sync.
# Local (host machine): point at the realtime server, e.g. after `docker compose up` (socket only), `docker compose -f compose.dev.yaml up` (web+socket), or `cd realtime-server && npm start`
# VITE_SOCKET_URL=http://localhost:3000

# Optional: YouTube Data API v3 key (browser-restricted) for resolving video titles on enqueue. When unset, titles show as unknown.
# VITE_YOUTUBE_API_KEY=
