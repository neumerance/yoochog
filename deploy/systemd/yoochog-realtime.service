[Unit]
Description=yoochog Socket.io realtime server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Match a dedicated deploy user, or `root` if you run the unit as the same user that owns /var/www/yoochog
User=root
Group=root
WorkingDirectory=/var/www/yoochog/current/realtime-server
Environment=NODE_ENV=production
Environment=PORT=3000
# Public https origin of the Vue app (no path) — required when not using default CORS "all".
Environment=SOCKET_CORS_ORIGIN=https://yoochoog.app
# Optional: server-only YouTube Data API key for guest search (search.list). Omit to disable search; guests use Paste link only.
# Environment=YOUTUBE_DATA_API_KEY=
# Optional: max search GETs per client IP per rolling minute (default 20).
# Environment=YOUTUBE_SEARCH_RATE_LIMIT_PER_MINUTE=20
# Optional: load secrets without editing the unit (e.g. PARTY_ADMIN_PASSWORD, YOUTUBE_DATA_API_KEY)
# EnvironmentFile=-/etc/yoochog/realtime.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
